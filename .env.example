# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider (Anthropic). Never name this ANTHROPIC_API_KEY, that name
# is not read by this project and must not be used, per CLAUDE.md.
ATLAS_ANTHROPIC_API_KEY=

# Part 2 (Gmail, Google Calendar, Anthropic) runs in n8n, not this repo's
# Python code, so its credentials live in n8n's own credential store.
# See n8n/README.md.
