# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider (Anthropic). Never name this ANTHROPIC_API_KEY - that name
# is not read by this project and must not be used, per CLAUDE.md.
ATLAS_ANTHROPIC_API_KEY=

# Langfuse (observability / tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Google OAuth (Calendar + Gmail tools)
GOOGLE_OAUTH_CLIENT_SECRETS_PATH=
